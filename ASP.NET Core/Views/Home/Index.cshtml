@using ASP_NET_Core.Models

@(Html.DevExtreme().TreeList<SampleEmployee>()
    .ID("employees")
    .DataSource(d => d.Mvc()
        .Controller("SampleData")
        .LoadAction("Get")
        .Key("ID")
    )
    .RootValue(-1)
    .KeyExpr("ID")
    .ParentIdExpr("Head_ID")
    .Columns(columns => {
        columns.Add()
            .DataField("Title")
            .Caption("Position");
        columns.Add().DataField("Full_Name");
        columns.Add().DataField("City");
        columns.Add().DataField("State");
        columns.Add().DataField("Mobile_Phone");
        columns.Add()
            .DataField("Hire_Date")
            .DataType(GridColumnDataType.Date);
    })
    .Sorting(s => s.Mode(GridSortingMode.Multiple))
    .SearchPanel(s => s.Visible(true))
    .FilterRow(f => f.Visible(true))
    .HeaderFilter(h => h.Visible(true))
    .ExpandedRowKeys(new[] { 1 })
    .ShowRowLines(true)
    .ShowBorders(true)
    .ColumnAutoWidth(true)
    .OnNodesInitialized("onNodesInitialized")
    .OnRowPrepared("onRowPrepared")
)

<script>
    function onNodesInitialized(e) {
        function calculateSummary(node) {
            let sum = 0;

            e.component.forEachNode(node.children, (n) => {
                if (n.visible) {
                    sum++;
                }
            });

            return sum;
        }

        function createSummaryNode(node, count) {
            return {
                key: `summary_${node.key}`,
                parent: node.parent,
                isSummary: true,
                data: {
                    Title: `Count: ${count}`,
                },
                children: [],
                visible: true,
            };
        }

        e.component.forEachNode([e.root], (node) => {
            const count = calculateSummary(node);

            if (count > 0) {
                node.children.push(createSummaryNode(node, count));
            }
        });
    }

    function onRowPrepared(e) {
        if (e.rowType === 'data' && e.node?.isSummary) {
            e.rowElement.addClass('summary-row');
        }
    }
</script>
